# Порт HTTP-сервера
PORT=3000

# Підключення до PostgreSQL (контейнер із docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=helper
DB_PASSWORD=helper
DB_NAME=allowed_actions

# Секрет для підпису JWT-токенів і термін їхньої дії в секундах
JWT_SECRET=change-me-before-deploy
JWT_EXPIRES_IN=3600
