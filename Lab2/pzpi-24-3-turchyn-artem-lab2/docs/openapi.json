  "info": {
    "title": "Allowed Actions API",
    "description": "REST API серверної частини програмної системи керування дозволеними діями мобільного застосунку через апаратний помічник",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "device-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Key"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "example": "Admin123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "uk",
          "en"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "new.operator@example.com"
          },
          "password": {
            "type": "string",
            "example": "Operator123!",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "example": "Петро Іваненко"
          },
          "roleId": {
            "type": "number",
            "example": 1,
            "description": "Ідентифікатор ролі (див. GET /api/roles)"
          },
          "locale": {
            "default": "uk",
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "timeZone": {
            "type": "string",
            "example": "Europe/Kyiv",
            "default": "Europe/Kyiv"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "roleId"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Петро Іваненко"
          },
          "roleId": {
            "type": "number",
            "example": 1
          },
          "locale": {
            "example": "en",
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "timeZone": {
            "type": "string",
            "example": "Europe/London"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "fullName",
          "roleId",
          "locale",
          "timeZone",
          "isActive"
        ]
      },
      "DeviceStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "REVOKED"
        ]
      },
      "CreateDeviceDto": {
        "type": "object",
        "properties": {
          "serialNumber": {
            "type": "string",
            "example": "HB-0003",
            "description": "Серійний номер: великі латинські літери, цифри, дефіс"
          },
          "name": {
            "type": "string",
            "example": "Помічник складу №2"
          },
          "ownerId": {
            "type": "number",
            "example": 3,
            "description": "Користувач, за яким закріплено пристрій"
          },
          "firmwareVersion": {
            "type": "string",
            "example": "1.0.0"
          }
        },
        "required": [
          "serialNumber",
          "name"
        ]
      },
      "UpdateDeviceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Помічник складу №1 (зміна Б)"
          },
          "ownerId": {
            "type": "object",
            "example": 3,
            "nullable": true
          },
          "firmwareVersion": {
            "type": "object",
            "example": "1.1.0",
            "nullable": true
          }
        },
        "required": [
          "name"
        ]
      },
      "RiskLevel": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH"
        ]
      },
      "ParameterType": {
        "type": "string",
        "enum": [
          "INTEGER",
          "NUMBER",
          "STRING",
          "BOOLEAN"
        ]
      },
      "ActionParameterDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "quantity",
            "description": "Код параметра (латиниця, camelCase)"
          },
          "nameUk": {
            "type": "string",
            "example": "Кількість"
          },
          "nameEn": {
            "type": "string",
            "example": "Quantity"
          },
          "type": {
            "example": "INTEGER",
            "allOf": [
              {
                "$ref": "#/components/schemas/ParameterType"
              }
            ]
          },
          "unit": {
            "type": "string",
            "example": "pcs",
            "description": "Одиниця вимірювання"
          },
          "minValue": {
            "type": "number",
            "example": 1
          },
          "maxValue": {
            "type": "number",
            "example": 500
          },
          "isRequired": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "code",
          "nameUk",
          "nameEn",
          "type"
        ]
      },
      "CreateActionDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "stock.write_off",
            "description": "Унікальний код дії (латиниця, крапка — роздільник)"
          },
          "nameUk": {
            "type": "string",
            "example": "Списати товар"
          },
          "nameEn": {
            "type": "string",
            "example": "Write off item"
          },
          "riskLevel": {
            "example": "HIGH",
            "allOf": [
              {
                "$ref": "#/components/schemas/RiskLevel"
              }
            ]
          },
          "isEnabled": {
            "type": "boolean",
            "example": true,
            "default": true
          },
          "roleIds": {
            "example": [
              1,
              3
            ],
            "description": "Ролі, яким дозволено виконувати дію",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionParameterDto"
            }
          }
        },
        "required": [
          "code",
          "nameUk",
          "nameEn",
          "riskLevel",
          "roleIds",
          "parameters"
        ]
      },
      "UpdateActionDto": {
        "type": "object",
        "properties": {
          "nameUk": {
            "type": "string",
            "example": "Списати пошкоджений товар"
          },
          "nameEn": {
            "type": "string",
            "example": "Write off damaged item"
          },
          "riskLevel": {
            "example": "HIGH",
            "allOf": [
              {
                "$ref": "#/components/schemas/RiskLevel"
              }
            ]
          },
          "isEnabled": {
            "type": "boolean",
            "example": false
          },
          "roleIds": {
            "example": [
              3
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "nameUk",
          "nameEn",
          "riskLevel",
          "isEnabled",
          "roleIds"
        ]
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "number",
            "example": 1,
            "description": "Апаратний помічник, через який працює користувач"
          }
        }
      },
      "CommandStatus": {
        "type": "string",
        "enum": [
          "CREATED",
          "PENDING_CONFIRMATION",
          "CONFIRMED",
          "DISPATCHED",
          "EXECUTED",
          "FAILED",
          "CANCELLED",
          "EXPIRED"
        ]
      },
      "CommandParameterValueDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "quantity"
          },
          "value": {
            "type": "string",
            "example": "12",
            "description": "Значення у текстовому вигляді"
          }
        },
        "required": [
          "code",
          "value"
        ]
      },
      "CreateCommandDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "number",
            "example": 2,
            "description": "Відкрита сесія поточного користувача"
          },
          "actionId": {
            "type": "number",
            "example": 2,
            "description": "Дія з каталогу (наприклад, stock.set_quantity)"
          },
          "idempotencyKey": {
            "type": "string",
            "example": "demo-cmd-0001",
            "description": "Ключ ідемпотентності, унікальний для команди"
          },
          "requestText": {
            "type": "string",
            "example": "зміни кількість SKU-778 на дванадцять"
          },
          "parameters": {
            "example": [
              {
                "code": "sku",
                "value": "SKU-778"
              },
              {
                "code": "quantity",
                "value": "12"
              }
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommandParameterValueDto"
            }
          }
        },
        "required": [
          "sessionId",
          "actionId",
          "idempotencyKey",
          "parameters"
        ]
      },
      "UpdateCommandStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "example": "CONFIRMED",
            "allOf": [
              {
                "$ref": "#/components/schemas/CommandStatus"
              }
            ]
          },
          "resultCode": {
            "type": "string",
            "example": "OK",
            "description": "Код результату від мобільного застосунку"
          }
        },
        "required": [
          "status"
        ]
      },
      "DeviceEventType": {
        "type": "string",
        "enum": [
          "BUTTON_SHORT",
          "BUTTON_DOUBLE",
          "BUTTON_LONG",
          "TOUCH_TAP",
          "TOUCH_HOLD",
          "ENCODER_TURN",
          "COMMAND_RESULT"
        ]
      },
      "DeviceEventDto": {
        "type": "object",
        "properties": {
          "eventUid": {
            "type": "string",
            "example": "HB-0001-000006",
            "description": "Унікальний ідентифікатор події на пристрої"
          },
          "seq": {
            "type": "number",
            "example": 6,
            "description": "Порядковий номер події (лічильник пристрою)"
          },
          "type": {
            "example": "BUTTON_SHORT",
            "allOf": [
              {
                "$ref": "#/components/schemas/DeviceEventType"
              }
            ]
          },
          "value": {
            "type": "number",
            "example": 2,
            "description": "Кроки енкодера, тривалість утримання (мс) або код результату"
          },
          "commandId": {
            "type": "number",
            "example": 1,
            "description": "Команда, до якої належить подія"
          },
          "occurredAt": {
            "type": "string",
            "example": "2026-11-22T09:15:00.000Z",
            "description": "Час події на пристрої (UTC, ISO 8601)"
          }
        },
        "required": [
          "eventUid",
          "seq",
          "type",
          "occurredAt"
        ]
      },
      "DeviceEventsBatchDto": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceEventDto"
            }
          }
        },
        "required": [
          "events"
        ]
      }
    }
  }
}
